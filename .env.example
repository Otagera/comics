# The canonical list of what this stack needs.
#
# Under Coolify these are set in the resource's Environment Variables tab, not
# in a file. For a local `docker compose up`, copy this to .env and fill it in.
# Never commit .env.

# --- domains ------------------------------------------------------------
# Both must resolve to this host with proxying OFF (grey cloud in
# Cloudflare): the Traefik certificate resolver uses an HTTP-01 challenge.
KOMGA_DOMAIN=komga.example.com
SIDECAR_DOMAIN=comics.example.com

# NOTE: VOLUME_ROOT, RCLONE_CONFIG, PROXY_NETWORK, the domains and the local
# ports are written literally in docker-compose.yml, because Coolify does not
# interpolate variables in volumes:, labels: or ports:. They are listed here
# for reference; changing them means editing the compose file.

# --- host layout --------------------------------------------------------
# Bulk data root. Bind-mounted into the sidecar at this same path so paths
# recorded in SQLite mean the same thing on the host and in the container.
VOLUME_ROOT=/mnt/HC_Volume_106816620
# rclone config, mounted read-only. Needs the Drive remote already set up.
# Required: volume and port values carry no inline defaults, because a ":-"
# default inside a volume or port string adds colons that stricter compose
# parsers (Coolify's among them) mis-split.
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# Docker network the Traefik proxy is on.
PROXY_NETWORK=coolify
TZ=UTC

# --- komga --------------------------------------------------------------
KOMGA_VERSION=1.26.3
KOMGA_HEAP=512m
# Created once via POST /api/v2/users/me/api-keys; returned in plaintext only
# at creation. KOMGA_LIBRARY_ID comes from GET /api/v1/libraries.
KOMGA_API_KEY=
KOMGA_LIBRARY_ID=

# --- sidecar ------------------------------------------------------------
# Image to run. CI publishes to GHCR and the deploy sets this; leave unset
# locally to build from source instead.
# SIDECAR_IMAGE=ghcr.io/otagera/comics-sidecar:latest
DRIVE_REMOTE=gdrive:Comics
# Keep the volume at or below this percentage; eviction enforces it.
BUDGET_PCT=80
# Basic auth, enforced by the app rather than by Traefik. Coolify interpolates
# environment but not labels, so an htpasswd line in a label never resolves --
# and hard-coding a password hash into a public repo is not an option.
# Leave both unset to run without auth (local development only).
SIDECAR_USER=you
SIDECAR_PASSWORD=change-me

# --- local ports (loopback only; required, no inline defaults) -----------
KOMGA_LOCAL_PORT=25600
SIDECAR_LOCAL_PORT=3001
